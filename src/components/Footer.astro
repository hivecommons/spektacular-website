---
const githubURL = "https://github.com/hivecommons/spektacular";
const releasesURL = "https://github.com/hivecommons/spektacular/releases";
const licenseURL = "https://github.com/hivecommons/spektacular/blob/main/LICENSE";
const hiveCommonsURL = "https://github.com/hivecommons";
---
<footer class="bg-bg-surface border-t border-border-subtle py-7 mt-auto">
  <div class="mx-auto max-w-[1100px] px-md">
    <div class="flex items-center justify-between flex-wrap gap-4 max-sm:flex-col max-sm:items-start">
      <div class="flex flex-col gap-1">
        <span class="text-sm text-text-muted">
          Spektacular (Spek) —
          <a
            href={licenseURL}
            class="text-text-secondary hover:text-text-primary no-underline"
            target="_blank"
            rel="noopener"
          >Apache 2.0</a>
        </span>
        <span class="text-sm text-text-muted">
          Part of
          <a
            href={hiveCommonsURL}
            class="text-text-secondary hover:text-text-primary no-underline"
            target="_blank"
            rel="noopener"
          >Hive Commons</a>
        </span>
      </div>
      <div class="flex gap-6">
        <a
          href={githubURL}
          class="text-sm text-text-secondary hover:text-text-primary no-underline"
          target="_blank"
          rel="noopener"
        >GitHub</a>
        <a
          href={hiveCommonsURL}
          class="text-sm text-text-secondary hover:text-text-primary no-underline"
          target="_blank"
          rel="noopener"
        >Hive Commons</a>
        <a
          href={releasesURL}
          class="text-sm text-text-secondary hover:text-text-primary no-underline"
          target="_blank"
          rel="noopener"
        >Releases</a>
      </div>
    </div>
  </div>
</footer>
